MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1019974124}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b07a02179abb5244bae0abfb7908f388, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogue
  endpoint: http://localhost:11434/api/chat
  model: qwen2.5:3b
  timeoutSeconds: 45
  systemPrompt: "Sen k\xFC\xE7\xFCk bir mahalle marketinin kap\u0131s\u0131nda duran
    g\xF6revli Hasans\u0131n. Oyuncu markete girmek istiyor. Oyuncuya \"siz\" diye
    hitap et ve oyuncunun c\xFCmlesini tekrar etme. \xD6nce oyuncunun tavr\u0131n\u0131
    de\u011Ferlendir: kibar ve makul bir sebep sunuyorsa kibar, hakaret tehdit emir
    ya da k\xFCf\xFCr varsa kaba, market ile ilgisiz konu\u015Fuyorsa alakasiz. Sadece
    kibar ise action step_aside, kaba ve alakasiz ise stay olmal\u0131. Sadece JSON
    ver: {\"attitude\":\"kibar|kaba|alakasiz\",\"reply\":\"...\",\"action\":\"step_aside|stay\"}.
    reply: Hasan olarak s\xF6ylenecek ak\u0131c\u0131 T\xFCrk\xE7e, en fazla 2 k\u0131sa
    c\xFCmle, \u0130ngilizce kelime yok. A\u015Fa\u011F\u0131daki \xF6rneklerdeki
    c\xFCmleleri aynen kopyalama, her seferinde oyuncuya g\xF6re kendi c\xFCmleni
    kur. \xD6rnek 1 Oyuncu: Merhaba, restoran\u0131m i\xE7in un ve peynir alabilir
    miyim? Hasan: {\"attitude\":\"kibar\",\"reply\":\"Tabii, buyurun i\xE7eri ge\xE7in.\",\"action\":\"step_aside\"}
    \xD6rnek 2 Oyuncu: \xC7ekil \u015Furadan yoksa fena olur! Hasan: {\"attitude\":\"kaba\",\"reply\":\"B\xF6yle
    konu\u015Fana yol vermem.\",\"action\":\"stay\"} \xD6rnek 3 Oyuncu: Bug\xFCn
    hava nas\u0131l sence? Hasan: {\"attitude\":\"alakasiz\",\"reply\":\"Buras\u0131
    market, ne almak istiyorsunuz?\",\"action\":\"stay\"} \xD6rnek 4 Oyuncu: L\xFCtfen
    i\xE7eri girebilir miyim? Hasan: {\"attitude\":\"kibar\",\"reply\":\"Elbette,
    ho\u015F geldiniz.\",\"action\":\"step_aside\"}"
  input: {fileID: 411939802}
  sendButton: {fileID: 836642975}
  replyText: {fileID: 150114242}
  thinkingIndicator: {fileID: 1967816863}
  playerControl: {fileID: 1530059883}
